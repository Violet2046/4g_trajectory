# Power Management (auto light sleep)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# Disable IDLE task watchdog (prevents TWDT timeout during sleep)
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n

# Main task stack (8KB for EPD refresh in main task context)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Partition table (single factory app, 1500K to fit BLE + EPD firmware)
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Bluetooth - NimBLE (BLE image transfer)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
# Disable unused roles to save ~15KB heap
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=n
# Disable security (no encryption needed for image transfer)
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
# Reduce buffer pools to save heap
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=16
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=24
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=24
CONFIG_BT_NIMBLE_ACL_BUF_SIZE=255

# WiFi - reduce memory footprint (lean config for coexistence)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_TX_BA_WIN=2
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=4
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# Reduce FreeRTOS timer task stack
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=2048

# Reduce log verbosity to save RAM (log strings are static)
CONFIG_LOG_DEFAULT_LEVEL=WARN
CONFIG_ESP_WIFI_TX_BA_WIN=2
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
